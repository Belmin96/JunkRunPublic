# ── Clerk (Authentication) ────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect paths
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/redirect
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/redirect

# Webhook secret — Clerk dashboard → Webhooks → Add endpoint → /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite by default so the app runs locally with zero setup. For production,
# switch prisma/schema.prisma's datasource provider to "postgresql" and point
# this at a hosted database (Neon: https://neon.tech).
DATABASE_URL="file:./dev.db"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com → Developers → API Keys (test mode)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Webhook secret — from Stripe CLI: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Web Push (real phone/browser notifications, no 3rd-party service) ────────
# Generate a pair with: npm run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Cron protection ───────────────────────────────────────────────────────────
# Required header (Authorization: Bearer <this>) on /api/cron/* routes so only
# your scheduler (Vercel Cron, or a manual admin button) can trigger them.
CRON_SECRET=change-me-to-a-random-string

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform fee percentage (10 = 10%) — JunkRun's cut, tracked separately from hauler payouts
PLATFORM_FEE_PERCENT=10

# Dispute window in hours (24 = 24 hours after verification)
DISPUTE_WINDOW_HOURS=24
